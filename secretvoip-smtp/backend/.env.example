# --- HTTP ---
PORT=4010
HOST=127.0.0.1
# Public base path the API is reachable under (Apache rewrites /smtp/api/* -> /api/*)
API_BASE_PATH=/api
TRUST_PROXY=1
# Comma-separated origins allowed for CORS. Same-origin (served under /smtp/) needs none.
CORS_ORIGINS=

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# AES-256-GCM key, 32 bytes hex (use: openssl rand -hex 32)
ENCRYPTION_KEY=replace-with-64-hex-chars

# --- Postgres ---
DATABASE_URL=postgres://secretvoip_smtp:CHANGE_ME@127.0.0.1:5432/secretvoip_smtp

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/3

# --- Worker ---
WORKER_CONCURRENCY=10
# Max emails dispatched per second from a single worker process
WORKER_RATE_PER_SECOND=20

# --- Defaults ---
DEFAULT_DAILY_LIMIT=5000
DEFAULT_MONTHLY_LIMIT=100000

# --- Logging ---
LOG_LEVEL=info
