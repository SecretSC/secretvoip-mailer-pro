[Unit]
Description=SecretVoIP SMTP Platform — Mail worker
After=network.target postgresql.service redis-server.service secretvoip-smtp-api.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/secretvoip-smtp/backend
EnvironmentFile=/var/www/secretvoip-smtp/backend/.env
ExecStart=/usr/bin/node dist/worker.js
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=append:/var/www/secretvoip-smtp/logs/worker.log
StandardError=append:/var/www/secretvoip-smtp/logs/worker.err.log

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/www/secretvoip-smtp

[Install]
WantedBy=multi-user.target
